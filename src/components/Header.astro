---
const path = Astro.url.pathname
const isBlog = path.startsWith('/blog')
---

<header class="px-4 pt-5 sm:pt-6">
	<nav class="mx-auto flex max-w-4xl items-baseline justify-between border-b border-background-secondary pb-4">
		<a
			href="/"
			class="text-lg font-semibold tracking-tight transition-colors hover:text-accent"
			aria-current={!isBlog ? 'page' : undefined}
		>
			Daniel Catonga
		</a>
		<a
			href="/blog"
			class:list={[
				'font-mono text-sm transition-colors hover:text-accent',
				isBlog ? 'text-tx-primary' : 'text-tx-secondary'
			]}
			aria-current={isBlog ? 'page' : undefined}
		>
			Blog
		</a>
	</nav>
</header>
