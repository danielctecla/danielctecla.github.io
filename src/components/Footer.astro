---
const currentYear = new Date().getFullYear()

const links = [
	{
		title: 'LinkedIn',
		url: 'https://linkedin.com/in/danielctecla',
		paths: [
			'M8 11v5',
			'M8 8v.01',
			'M12 16v-5',
			'M16 16v-3a2 2 0 1 0 -4 0',
			'M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z'
		]
	},
	{
		title: 'GitHub',
		url: 'https://github.com/danielctecla',
		paths: [
			'M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5'
		]
	},
	{
		title: 'X',
		url: 'https://x.com/danielctecla',
		paths: ['M4 4l11.733 16h4.267l-11.733 -16z', 'M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772']
	},
	{
		title: 'Instagram',
		url: 'https://instagram.com/danielctecla',
		paths: [
			'M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z',
			'M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0',
			'M16.5 7.5v.01'
		]
	},
	{
		title: 'Email',
		url: 'mailto:daniel.ctecla@gmail.com',
		paths: [
			'M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z',
			'M3 7l9 6l9 -6'
		]
	}
]
---

<footer class="mt-20 px-4 pb-12">
	<div class="mx-auto max-w-2xl border-t border-background-secondary pt-8">
		<p class="text-lg leading-snug">
			Have an idea, a role, or just want to talk about AI? I'd love to hear from you.
		</p>

		<ul class="mt-5 flex gap-5">
			{
				links.map(({ title, url, paths }) => (
					<li>
						<a
							href={url}
							aria-label={title}
							title={title}
							class="block text-tx-secondary transition-colors hover:text-accent"
							{...(!url.startsWith('mailto:') && { target: '_blank', rel: 'noopener me' })}
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="size-6"
								aria-hidden="true"
							>
								{paths.map((d) => (
									<path d={d} />
								))}
							</svg>
						</a>
					</li>
				))
			}
		</ul>

		<div class="mt-10 flex justify-between font-mono text-xs text-tx-secondary">
			<span>© {currentYear} Daniel Catonga</span>
			<a href="#" class="transition-colors hover:text-tx-primary">back to top ↑</a>
		</div>
	</div>
</footer>
